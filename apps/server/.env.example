# Copy to .env for local runs. Every value here is a placeholder; never commit real secrets.
# Variables are SECTION__KEY (see src/app.config.ts).

NODE_ENV=development

SERVER__PORT=8787
# Express `trust proxy`: set to the hops in front of the server so rate limits see client IPs.
SERVER__TRUST_PROXY=loopback

DATABASE__URL=postgres://comma:comma@localhost:55432/comma

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT__SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Refresh tokens expire this many days after their last rotation.
AUTH__REFRESH_TTL_DAYS=30

# console (development: logs that a code was sent) or smtp (required in production).
MAILER__DRIVER=console
# 1 prints verification codes in the console mailer's log. Refused in production.
MAILER__DEV_PRINT_CODES=0
MAILER__FROM=Comma <no-reply@example.com>
# smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465
MAILER__SMTP_URL=

# --- Comma credits: the provider keys voice runs use (POST /v1/voice/runs). ---
# Without ELEVENLABS__API_KEY, or without the LLM key and model, voice runs answer 503 provider_not_configured.

# ElevenLabs Speech to Text. The key needs the speech_to_text permission.
ELEVENLABS__API_KEY=
ELEVENLABS__MODEL=scribe_v3
# ELEVENLABS__BASE_URL=https://api.elevenlabs.io

# openai-compatible (any /chat/completions endpoint, e.g. a local magpie gateway at http://127.0.0.1:3425/v1)
# or deepseek (the official DeepSeek API).
# Production: LLM__PROVIDER=deepseek, LLM__BASE_URL empty (defaults to https://api.deepseek.com), and a model id
# from https://api-docs.deepseek.com, e.g. deepseek-v4-flash.
LLM__PROVIDER=openai-compatible
LLM__BASE_URL=http://127.0.0.1:3425/v1
LLM__API_KEY=
LLM__MODEL=
# off (no thinking: reasoning_effort "none", or thinking disabled on DeepSeek), low, medium, high,
# or default (field omitted: the model's own default).
LLM__REASONING_EFFORT=off

# Weekly allowance of the free plan, in seconds of audio (ISO week, UTC).
QUOTA__FREE_WEEKLY_SECONDS=1800
