{
  "name": "@comma/server",
  "version": "0.0.0",
  "private": true,
  "description": "Comma account server: auth, users, devices, dictionary, and voice runs on Comma credits for the desktop app.",
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/migrate.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "3.0.87",
    "@ai-sdk/openai-compatible": "3.0.92",
    "@comma/shared": "workspace:*",
    "@nestjs/authentication": "~0.1.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/drizzle": "~0.0.2",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "ai": "7.0.173",
    "drizzle-orm": "^0.45.4",
    "express": "5.3.0",
    "jose": "^6.2.13",
    "nest-typed-config": "^2.10.1",
    "nodemailer": "~10.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.2.0",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3"
  }
}
