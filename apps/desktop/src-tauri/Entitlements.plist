<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- A build signed with the hardened runtime may use the microphone only with this entitlement; without it macOS
       denies access without ever showing the prompt, and Comma never appears under Privacy > Microphone. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
